# ── Supabase (banco de dados) ─────────────────────────────────────────────────
# Crie um projeto em https://supabase.com e copie as credenciais:
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ── EmailJS (envio de e-mail de confirmação) ──────────────────────────────────
# Crie uma conta em https://www.emailjs.com e configure:
# 1. Um serviço de e-mail (Gmail, etc.)
# 2. Um template com as variáveis: client_name, client_email, services,
#    date, time, total_price, whatsapp
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=sua-public-key-aqui

# ── Supabase Auth / server-side ───────────────────────────────────────────────
# SUPABASE_URL pode ser igual à URL pública; não é segredo.
SUPABASE_URL=https://seu-projeto.supabase.co
# Nunca exponha esta chave no VITE_* nem no frontend.
SUPABASE_SERVICE_ROLE_KEY=cole-a-chave-privada-somente-no-Vercel

# ── WhatsApp Business API server-side ─────────────────────────────────────────
# Configure somente como variáveis privadas no Vercel.
WHATSAPP_ACCESS_TOKEN=cole-o-token-privado-somente-no-Vercel
WHATSAPP_PHONE_NUMBER_ID=seu-phone-number-id
WHATSAPP_API_VERSION=v18.0

# ── Google Calendar server-side sync ─────────────────────────────────────────
# A agenda deve ser exclusiva para o agente SuperGator e compartilhada com a
# conta de serviço com permissão para criar, editar e excluir eventos.
GOOGLE_CALENDAR_ID=agenda-exclusiva@group.calendar.google.com
GOOGLE_CALENDAR_TIMEZONE=America/Fortaleza
GOOGLE_CALENDAR_TIMEZONE_OFFSET=-03:00
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@seu-projeto.iam.gserviceaccount.com
# Armazene a chave privada como variável segura; não commite este valor.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# Comece em false para homologação. Ative true somente após teste real.
GOOGLE_CALENDAR_REQUIRED=false
# Segredo privado enviado pelo cron do Vercel para a reconciliação automática.
CRON_SECRET=gere-um-segredo-longo-e-aleatorio

# ── Supabase Auth metadata ────────────────────────────────────────────────────
# O usuário administrativo precisa de app_metadata.role=admin.
# Usuários de equipe precisam de role=staff, professional_name e active=true.
