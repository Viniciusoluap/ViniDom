{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/agent-inbound.js": { "maxDuration": 60 },
    "api/agent-cron.js": { "maxDuration": 300 }
  },
  "crons": [
    {
      "path": "/api/calendar-reconcile",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/agent-cron",
      "schedule": "5 12-22 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
